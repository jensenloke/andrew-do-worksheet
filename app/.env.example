# Copy to app/.env and fill in. ANDREW talks to any OpenAI-compatible endpoint.
#
#   cp .env.example .env
#
# Then verify connectivity with:  npm run check-model

DO_AGENT_BASE_URL=https://openrouter.ai/api/v1
DO_AGENT_MODEL=anthropic/claude-3.5-sonnet
DO_AGENT_API_KEY=sk-or-...

# --- Other providers (set BASE_URL + MODEL + API_KEY) ---
# OpenAI:      https://api.openai.com/v1                    gpt-4o
# DashScope:   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Local Ollama: http://localhost:11434/v1                    (key can be anything)
# Local vLLM:  http://localhost:8000/v1
# Local DGX:   http://127.0.0.1:18001/lm/v1
